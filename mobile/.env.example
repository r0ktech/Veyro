# Same Supabase project as the website (Supabase → Project Settings → API). Safe to ship in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# The Veyro website. Serves product photos and POST /api/checkout. No trailing slash.
# Deployed:   https://your-app.vercel.app
# Local dev:  http://<your computer's Wi-Fi IP>:3000   (phone and computer on the same Wi-Fi)
EXPO_PUBLIC_API_URL=https://your-app.vercel.app
