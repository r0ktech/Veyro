# Supabase → Project Settings → API (the publishable / anon key is safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Public URL of the site (used for links in emails). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mailgun → Send → Sending → Domain settings → Sending API keys
MAILGUN_API_KEY=your-mailgun-sending-key
MAILGUN_DOMAIN=sandboxXXXXXXXX.mailgun.org
MAILGUN_FROM="Veyro <postmaster@sandboxXXXXXXXX.mailgun.org>"
# Use https://api.eu.mailgun.net if your Mailgun domain is in the EU region
MAILGUN_API_URL=https://api.mailgun.net
